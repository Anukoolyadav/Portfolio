# Copy to .env and fill in real values. Never commit .env.

# ── Required — the server refuses to start without these ──────────────────────
# bcrypt hash of the admin password. Generate with:  npm run hash-password
# The hash contains "$" characters; single quotes are recommended (dotenv 16
# also reads it unquoted). On hosting dashboards (Render) paste it WITHOUT quotes.
ADMIN_PASS_HASH='$2b$12$replace.with.the.output.of.npm.run.hash-password.xxxxxxxxx'

# Signs the admin session cookie. At least 32 characters. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# ── Optional ──────────────────────────────────────────────────────────────────
# Without it the DB-backed features are disabled (seed data is shown instead)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Without it the contact form returns 503
RESEND_API_KEY=

PORT=3000
NODE_ENV=development
