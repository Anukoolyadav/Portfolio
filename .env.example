# Copy to .env and fill in real values. Never commit .env.

# Required — server refuses to start without it
ADMIN_PASS=change-me-to-a-long-random-string

# Optional — without it the DB-backed admin features are disabled
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>

# Optional — without it the contact form returns 503
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
NODE_ENV=development
