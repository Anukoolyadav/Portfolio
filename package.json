{
  "name": "anukool-portfolio",
  "version": "1.0.0",
  "description": "Anukool Yadav's portfolio — vanilla frontend with an Express + MongoDB backend and admin panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && npx nodemon server.js",
    "build": "vite build",
    "dev:client": "vite",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand",
    "hash-password": "node scripts/hash-password.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^8.0.3",
    "resend": "^6.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
